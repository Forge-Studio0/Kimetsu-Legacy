            { "controller.render.wolf_body": "!variable.is_first_person && (query.property('kny:forms') == 1)" },
            { "controller.render.serpent": "!variable.is_first_person && (query.property('kny:effects') == 1)" },
            { "controller.render.serpent_double": "!variable.is_first_person && (query.property('kny:effects') == 2)" }
         ],
      "enable_attachables": true
    }
  }
}
