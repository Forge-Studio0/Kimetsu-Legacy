{
  "namespace": "kny_oficina",
  "moldura": {
    "type": "image",
    "texture": "textures/ui/customizacao/painel",
    "size": ["100%", "100%"],
    "nineslice_size": 12,
    "layer": 2
  },
  "linha": {
    "type": "image",
    "texture": "textures/ui/customizacao/botao",
    "size": ["100% - 2px", "100% - 2px"],
    "nineslice_size": 6,
    "layer": 3
  },
  "linha_dourada@kny_oficina.linha": {
    "texture": "textures/ui/customizacao/salvar"
  },
  "icone": {
    "$icone_tamanho|default": ["25%", "78%"],
    "$icone_ancora|default": "left_middle",
    "$icone_offset|default": ["3%", 0],
    "type": "image",
    "size": "$icone_tamanho",
    "keep_ratio": true,
    "anchor_from": "$icone_ancora",
    "anchor_to": "$icone_ancora",
    "offset": "$icone_offset",
    "layer": 5,
    "bindings": [
      { "binding_name": "#form_button_texture", "binding_name_override": "#texture", "binding_type": "collection", "binding_collection_name": "form_buttons" },
      { "binding_name": "#form_button_texture_file_system", "binding_name_override": "#texture_file_system", "binding_type": "collection", "binding_collection_name": "form_buttons" },
      { "binding_type": "view", "source_property_name": "(not (#texture = ''))", "target_property_name": "#visible" }
    ]
  },
  "botao@server_form.kny_btn_base": {
    "$lbl_anchor": "center",
    "$lbl_offset": [0, 0],
    "$lbl_size": ["97%", "default"],
    "$lbl_align": "center",
    "$lbl_scale": 0.75,
    "controls": [
      { "fundo@kny_oficina.linha": {} },
      {
        "realce@kny_oficina.linha_dourada": {
          "bindings": [
            { "binding_name": "#form_button_text", "binding_type": "collection", "binding_collection_name": "form_buttons" },
            { "binding_type": "view", "source_property_name": "((('%.2s' * #form_button_text) = 'S:') or (('%.2s' * #form_button_text) = 'V:') or (('%.2s' * #form_button_text) = 'A:'))", "target_property_name": "#visible" }
          ]
        }
      },
      {
        "default": {
          "type": "panel"
        }
      },
      {
        "hover": {
          "type": "image",
          "texture": "textures/ui/White",
          "color": [1, 0.79, 0.42],
          "alpha": 0.18,
          "size": ["100% - 2px", "100% - 2px"],
          "layer": 4
        }
      },
      {
        "pressed": {
          "type": "image",
          "texture": "textures/ui/White",
          "color": [1, 0.79, 0.42],
          "alpha": 0.37,
          "size": ["100% - 2px", "100% - 2px"],
          "layer": 4
        }
      },
      { "icone@kny_oficina.icone": {} },
      { "texto@server_form.kny_label": {} }
    ]
  },
  "categoria@kny_oficina.botao": {
    "size": ["100%", "33.33%"],
    "$vis": "((('%.2s' * #form_button_text) = 'C:') or (('%.2s' * #form_button_text) = 'S:'))",
    "$txt": "((#form_button_text - 'C:') - 'S:')",
    "$lbl_anchor": "left_middle",
    "$lbl_offset": ["31%", 0],
    "$lbl_size": ["67%", "default"],
    "$lbl_align": "left",
    "$lbl_scale": 0.70
  },
  "opcao@kny_oficina.botao": {
    "size": ["100%", "33.33%"],
    "clips_children": true,
    "$vis": "((('%.2s' * #form_button_text) = 'A:') or (('%.2s' * #form_button_text) = 'O:'))",
    "$txt": "((#form_button_text - 'A:') - 'O:')",
    "$lbl_anchor": "left_middle",
    "$lbl_offset": ["5%", 0],
    "$lbl_size": ["76%", "default"],
    "$lbl_align": "left",
    "$lbl_scale": 0.72,
    "$icone_tamanho": ["13%", "51%"],
    "$icone_ancora": "right_middle",
    "$icone_offset": ["-4%", 0]
  },
  "titulo@server_form.kny_txt_base": {
    "size": ["100%", "100%"],
    "$vis": "(('%.2s' * #form_button_text) = 'T:')",
    "$txt": "(#form_button_text - 'T:')",
    "$lbl_anchor": "left_middle",
    "$lbl_offset": ["6%", 0],
    "$lbl_size": ["91%", "default"],
    "$lbl_align": "left",
    "$lbl_scale": 0.84
  },
  "nota@kny_oficina.titulo": {
    "$vis": "(('%.2s' * #form_button_text) = 'H:')",
    "$txt": "(#form_button_text - 'H:')",
    "$lbl_scale": 0.72
  },
  "anterior@kny_oficina.botao": {
    "size": ["100%", "100%"],
    "$vis": "(('%.2s' * #form_button_text) = 'P:')",
    "$txt": "(#form_button_text - 'P:')"
  },
  "proximo@kny_oficina.anterior": {
    "$vis": "(('%.2s' * #form_button_text) = 'N:')",
    "$txt": "(#form_button_text - 'N:')"
  },
  "comando@kny_oficina.botao": {
    "size": ["16.6666%", "100%"],
    "$vis": "(('%.2s' * #form_button_text) = 'K:')",
    "$txt": "(#form_button_text - 'K:')",
    "$lbl_scale": 0.65
  },
  "decisao@kny_oficina.botao": {
    "size": ["50%", "100%"],
    "$vis": "((('%.2s' * #form_button_text) = 'V:') or (('%.2s' * #form_button_text) = 'X:'))",
    "$txt": "((#form_button_text - 'V:') - 'X:')"
  },
  "cortina": {
    "type": "image",
    "texture": "textures/ui/White",
    "color": [0.07, 0.022, 0.034],
    "layer": 1
  },
  "borda": {
    "type": "image",
    "texture": "textures/ui/White",
    "color": [0.66, 0.47, 0.20],
    "layer": 3
  },
  "camada_retrato": {
    "type": "image",
    "size": ["100%", "100%"],
    "keep_ratio": false,
    "bindings": [
      { "binding_type": "collection_details", "binding_collection_name": "form_buttons" },
      { "binding_name": "#form_button_text", "binding_type": "collection", "binding_collection_name": "form_buttons" },
      { "binding_name": "#form_button_texture", "binding_name_override": "#texture", "binding_type": "collection", "binding_collection_name": "form_buttons" },
      { "binding_name": "#form_button_texture_file_system", "binding_name_override": "#texture_file_system", "binding_type": "collection", "binding_collection_name": "form_buttons" },
      { "binding_type": "view", "source_property_name": "$vis", "target_property_name": "#visible" }
    ]
  },
  "retrato_pele@kny_oficina.camada_retrato": {
    "$vis": "(('%.3s' * #form_button_text) = 'PV:')",
    "layer": 4
  },
  "retrato_olho_e@kny_oficina.camada_retrato": {
    "$vis": "(('%.3s' * #form_button_text) = 'PE:')",
    "layer": 5
  },
  "retrato_olho_d@kny_oficina.camada_retrato": {
    "$vis": "(('%.3s' * #form_button_text) = 'PD:')",
    "layer": 5
  },
  "retrato_cabelo@kny_oficina.camada_retrato": {
    "$vis": "(('%.3s' * #form_button_text) = 'PC:')",
    "layer": 6
  },
  "retrato_mecha@kny_oficina.camada_retrato": {
    "$vis": "(('%.3s' * #form_button_text) = 'PM:')",
    "layer": 7
  },
  "botoes": {
    "type": "collection_panel",
    "size": ["100%", "100%"],
    "factory": { "name": "buttons", "control_name": "$item" },
    "collection_name": "form_buttons",
    "bindings": [
      { "binding_name": "#form_button_length", "binding_name_override": "#collection_length" }
    ]
  },
  "botao_criacao@kny_oficina.botao": {
    "size": ["100%", "100%"],
    "$vis": "(#form_button_text = 'Crie seu personagem')",
    "$txt": "#form_button_text",
    "$lbl_scale": 1.05
  },
  "criacao": {
    "type": "panel",
    "size": ["56%", "34%"],
    "anchor_from": "center",
    "anchor_to": "center",
    "controls": [
      { "moldura@kny_oficina.moldura": {} },
      {
        "titulo": {
          "type": "label",
          "text": "KIMETSU LEGACY",
          "color": [0.95, 0.8, 0.47],
          "font_scale_factor": 1.2,
          "text_alignment": "center",
          "size": ["90%", "default"],
          "anchor_from": "center",
          "anchor_to": "center",
          "offset": [0, "-22%"],
          "layer": 5
        }
      },
      {
        "avancar@kny_oficina.botoes": {
          "$item": "kny_oficina.botao_criacao",
          "size": ["82%", "32%"],
          "anchor_from": "center",
          "anchor_to": "center",
          "offset": [0, "19%"]
        }
      }
    ]
  },
  "editor": {
    "type": "panel",
    "size": ["100%", "100%"],
    "controls": [
      {
        "fundo_estatico@kny_oficina.cortina": {
          "size": ["100%", "100%"],
          "bindings": [
            { "binding_name": "#title_text" },
            { "binding_type": "view", "source_property_name": "(('%.10s' * #title_text) = 'kny_edit|R')", "target_property_name": "#visible" }
          ]
        }
      },
      { "cima@kny_oficina.cortina": { "size": ["100%", "13%"], "anchor_from": "top_middle", "anchor_to": "top_middle" } },
      { "esquerda@kny_oficina.cortina": { "size": ["24%", "100%"], "anchor_from": "left_middle", "anchor_to": "left_middle" } },
      { "direita@kny_oficina.cortina": { "size": ["24%", "100%"], "anchor_from": "right_middle", "anchor_to": "right_middle" } },
      { "baixo@kny_oficina.cortina": { "size": ["100%", "19%"], "anchor_from": "bottom_middle", "anchor_to": "bottom_middle" } },
      {
        "faixa": {
          "type": "panel",
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [0, "2%"],
          "size": ["51%", "8.5%"],
          "controls": [
            { "moldura@kny_oficina.moldura": {} },
            {
              "nome": {
                "type": "label",
                "size": ["96%", "default"],
                "layer": 5,
                "text": "APARÊNCIA DO PERSONAGEM",
                "color": [0.95, 0.8, 0.47],
                "shadow": true,
                "font_scale_factor": 0.86,
                "text_alignment": "center",
                "anchor_from": "center",
                "anchor_to": "center"
              }
            }
          ]
        }
      },
      {
        "categorias": {
          "type": "panel",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": ["1.6%", "13%"],
          "size": ["18%", "33%"],
          "controls": [
            { "moldura@kny_oficina.moldura": {} },
            {
              "lista@kny_oficina.botoes": {
                "type": "stack_panel",
                "orientation": "vertical",
                "size": ["94%", "94%"],
                "$item": "kny_oficina.categoria"
              }
            }
          ]
        }
      },
      {
        "configuracoes": {
          "type": "panel",
          "anchor_from": "top_right",
          "anchor_to": "top_right",
          "offset": ["-1%", "13%"],
          "size": ["22%", "68%"],
          "controls": [
            { "moldura@kny_oficina.moldura": {} },
            {
              "categoria@kny_oficina.botoes": {
                "size": ["97%", "19%"],
                "anchor_from": "top_middle",
                "anchor_to": "top_middle",
                "offset": [0, "2%"],
                "$item": "kny_oficina.titulo"
              }
            },
            {
              "config@kny_oficina.botoes": {
                "type": "stack_panel",
                "orientation": "vertical",
                "size": ["92%", "53%"],
                "anchor_from": "top_middle",
                "anchor_to": "top_middle",
                "offset": [0, "21%"],
                "$item": "kny_oficina.opcao"
              }
            },
            {
              "nota@kny_oficina.botoes": {
                "size": ["94%", "8%"],
                "anchor_from": "top_middle",
                "anchor_to": "top_middle",
                "offset": [0, "74%"],
                "$item": "kny_oficina.nota"
              }
            },
            {
              "voltar@kny_oficina.botoes": {
                "size": ["45%", "12%"],
                "anchor_from": "bottom_left",
                "anchor_to": "bottom_left",
                "offset": ["3%", "-4%"],
                "$item": "kny_oficina.anterior"
              }
            },
            {
              "avancar@kny_oficina.botoes": {
                "size": ["45%", "12%"],
                "anchor_from": "bottom_right",
                "anchor_to": "bottom_right",
                "offset": ["-3%", "-4%"],
                "$item": "kny_oficina.proximo"
              }
            }
          ]
        }
      },
      {
        "visor": {
          "type": "panel",
          "size": ["52%", "68%"],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [0, "13%"],
          "clips_children": true,
          "controls": [
            { "linha_cima@kny_oficina.borda": { "size": ["100%", 1], "anchor_from": "top_middle", "anchor_to": "top_middle" } },
            { "linha_baixo@kny_oficina.borda": { "size": ["100%", 1], "anchor_from": "bottom_middle", "anchor_to": "bottom_middle" } },
            { "linha_esquerda@kny_oficina.borda": { "size": [1, "100%"], "anchor_from": "left_middle", "anchor_to": "left_middle" } },
            { "linha_direita@kny_oficina.borda": { "size": [1, "100%"], "anchor_from": "right_middle", "anchor_to": "right_middle" } },
            {
              "retrato": {
                "type": "panel",
                "size": ["51.28%y", "88%"],
                "max_size": ["94%", "88%"],
                "anchor_from": "center",
                "anchor_to": "center",
                "bindings": [
                  { "binding_name": "#title_text" },
                  { "binding_type": "view", "source_property_name": "(('%.10s' * #title_text) = 'kny_edit|R')", "target_property_name": "#visible" }
                ],
                "controls": [
                  { "pele@kny_oficina.botoes": { "$item": "kny_oficina.retrato_pele" } },
                  { "olho_e@kny_oficina.botoes": { "$item": "kny_oficina.retrato_olho_e" } },
                  { "olho_d@kny_oficina.botoes": { "$item": "kny_oficina.retrato_olho_d" } },
                  { "cabelo@kny_oficina.botoes": { "$item": "kny_oficina.retrato_cabelo" } },
                  { "mecha@kny_oficina.botoes": { "$item": "kny_oficina.retrato_mecha" } }
                ]
              }
            },
            {
              "pele_da_conta": {
                "type": "label",
                "size": ["86%", "default"],
                "anchor_from": "center",
                "anchor_to": "center",
                "text_alignment": "center",
                "text": "§6Pele da conta\n§7Você verá sua skin no jogo",
                "font_scale_factor": 0.84,
                "layer": 6,
                "bindings": [
                  { "binding_name": "#title_text" },
                  { "binding_type": "view", "source_property_name": "(('%.11s' * #title_text) = 'kny_edit|RA')", "target_property_name": "#visible" }
                ]
              }
            }
          ]
        }
      },
      {
        "camera@kny_oficina.botoes": {
          "type": "stack_panel",
          "orientation": "horizontal",
          "size": ["52%", "8%"],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [0, "81.5%"],
          "$item": "kny_oficina.comando"
        }
      },
      {
        "decisoes@kny_oficina.botoes": {
          "type": "stack_panel",
          "orientation": "horizontal",
          "size": ["38%", "8%"],
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "offset": [0, "-1.2%"],
          "$item": "kny_oficina.decisao"
        }
      }
    ]
  }
}
